{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["../apps/api/node_modules/@cloudflare/workers-types"],
    "baseUrl": "../apps/api",
    "paths": {
      "@/*": ["./src/*"],
      "hono": ["./node_modules/hono"],
      "hono/cors": ["./node_modules/hono/dist/types/middleware/cors/index.d.ts"],
      "hono/*": ["./node_modules/hono/*"],
      "@cpa-study/db": ["../../packages/db/src/index.ts"],
      "@cpa-study/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": [
    "./server/**/*.ts",
    "../apps/api/src/**/*.ts",
    "../packages/db/src/**/*.ts"
  ]
}
